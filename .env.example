# Skopiuj do .env (plik .env jest w .gitignore). Nie commituj kluczy API.

# --- LLM: OpenRouter (start) ---
# Klucz: https://openrouter.ai/settings/keys. W ustawieniach prywatności konta wyłącz logowanie promptów.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Model :free z https://openrouter.ai/api/v1/models (sprawdzony 2026-11-25, lista się zmienia).
# Domyślny model (dostawca: Nvidia, rozumowanie domyślnie włączone).
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Gemma :free (Google AI Studio): 2026-11-25 stale 429 ze wspólnej puli dostawcy.
# LLM_MODEL=google/gemma-4-31b-it:free
LLM_TEMPERATURE=0.2
LLM_SEED=42

# --- LLM: Ollama lokalnie (zadanie T-06) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=SpeakLeash/bielik-11b-v3.1-instruct:Q4_K_M

# --- RAG ---
PROMPT_VERSION=v1
TOP_K=5
CHUNK_MAX_CHARS=1200
EMBEDDING_MODEL=sdadas/mmlw-retrieval-roberta-large
EMBEDDING_QUERY_PREFIX="zapytanie: "
CHROMA_DIR=data/chroma
RUN_LOG_PATH=experiments/results/runs.jsonl

# --- Prywatność bibliotek ---
GRADIO_ANALYTICS_ENABLED=False
HF_HUB_DISABLE_TELEMETRY=1
